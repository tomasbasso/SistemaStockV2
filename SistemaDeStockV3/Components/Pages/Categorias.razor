@page "/categorias"
@using SistemaDeStockV3.Models
@using SistemaDeStockV3.Services
@using SistemaDeStockV3.Components.Shared
@inject DataService Data
@inject NotificationService Notifications

<div class="max-w-6xl mx-auto">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
            <h2 class="page-title mb-1">Categorías</h2>
            <p class="page-subtitle">Gestiona las familias de productos</p>
        </div>
        <button @onclick="OpenNew" class="btn btn-primary btn-lg flex items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Nueva Categoría</span>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            @for(int i = 0; i < 3; i++)
            {
                <div class="premium-card p-6 min-h-[120px] animate-pulse relative overflow-hidden">
                    <div class="h-6 w-3/4 bg-white/5 rounded mt-2"></div>
                </div>
            }
        </div>
    }
    else if (!items.Any())
    {
        <div class="text-center py-20 bg-white/5 rounded-2xl border border-white/5 border-dashed">
            <i class="bi bi-tags text-4xl text-gray-400 mb-4 block"></i>
            <h3 class="text-lg font-medium text-white mb-2">No hay categorías registradas</h3>
            <p class="text-gray-400 mb-6">Crea tu primera categoría para empezar a organizar tu inventario.</p>
            <button @onclick="OpenNew" class="text-[var(--color-primary)] hover:text-white transition-colors">Crear Categoría &rarr;</button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
            @for (var i = 0; i < items.Count; i++)
            {
                var cat = items[i];
                var color = GetCategoryColor(i);
                productCounts.TryGetValue(cat.Id, out var productCount);
                <div class="premium-card overflow-hidden flex flex-col justify-between group hover:-translate-y-1 transition-transform duration-300"
                     style="border-top: 3px solid @color">
                    <div class="p-6">
                        <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-4 text-lg"
                             style="background-color: @(color)22; color: @color">
                            <i class="bi bi-tag-fill"></i>
                        </div>
                        <h3 class="text-base font-bold mb-1" style="color: var(--color-ink)">@cat.Name</h3>
                        <p class="text-sm" style="color: var(--color-muted)">
                            @productCount producto@(productCount == 1 ? "" : "s")
                        </p>
                    </div>

                    <div class="px-6 pb-5 flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                        <button @onclick="() => OpenViewProducts(cat)" title="Ver productos" class="w-8 h-8 rounded-md bg-white/5 text-gray-300 hover:text-white hover:bg-[var(--color-primary)] transition-colors flex items-center justify-center">
                            <i class="bi bi-eye"></i>
                        </button>
                        <button @onclick="() => OpenEdit(cat)" title="Editar" class="w-8 h-8 rounded-md bg-white/5 text-gray-300 hover:text-white hover:bg-[var(--color-primary)] transition-colors flex items-center justify-center">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button @onclick="() => OpenDelete(cat)" title="Eliminar" class="w-8 h-8 rounded-md bg-white/5 text-gray-300 hover:text-white hover:bg-[var(--color-danger)] transition-colors flex items-center justify-center">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }

</div>

<!-- Modal -->
<AppModal IsOpen="isModalOpen" IsOpenChanged="(v) => isModalOpen = v" Title="@(isEditMode ? "Editar Categória" : "Nueva Categoría")">
    <EditForm Model="editingItem" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-2">Nombre de la Categoría</label>
                <InputText @bind-Value="editingItem.Name" autofocus class="w-full bg-black/20 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)] transition-all" placeholder="Ej: Herramientas Manuales" />
                <ValidationMessage For="() => editingItem.Name" class="text-[var(--color-danger)] text-xs mt-1 block" />
            </div>
        </div>
        <div class="mt-8 flex justify-end gap-3">
            <button type="button" @onclick="() => isModalOpen = false" class="btn btn-ghost">Cancelar</button>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </EditForm>
</AppModal>

<!-- Delete Modal -->
<AppModal IsOpen="isDeleteModalOpen" IsOpenChanged="(v) => isDeleteModalOpen = v" Title="Corfirmar Eliminación">
    <div class="py-4">
        <p class="text-gray-300">¿Estás seguro de que deseas eliminar la categoría <strong>@deletingItem?.Name</strong>?</p>
        <p class="text-sm text-[var(--color-danger)] mt-2"><i class="bi bi-exclamation-triangle-fill mr-1"></i> Esta acción no se puede deshacer.</p>
    </div>
    <div class="mt-6 flex justify-end gap-3">
        <button @onclick="() => isDeleteModalOpen = false" class="btn btn-ghost">Cancelar</button>
        <button @onclick="ConfirmDelete" class="btn btn-danger">Eliminar</button>
    </div>
</AppModal>

<!-- View Products Modal -->
<AppModal IsOpen="isViewProductsOpen" IsOpenChanged="(v) => isViewProductsOpen = v" Title="@($"Productos en: {viewingCategory?.Name}")">
    @if (viewingProducts == null)
    {
        <div class="flex justify-center py-8">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[var(--color-primary)]"></div>
        </div>
    }
    else if (!viewingProducts.Any())
    {
        <div class="text-center py-12">
            <i class="bi bi-box-seam text-4xl text-gray-500 block mb-3"></i>
            <p class="text-gray-400">No hay productos en esta categoría.</p>
        </div>
    }
    else
    {
        <div class="mb-3 text-sm text-gray-400">
            <span class="text-[var(--color-primary)] font-semibold">@viewingProducts.Count</span> producto@(viewingProducts.Count == 1 ? "" : "s")
        </div>
        <div class="overflow-x-auto rounded-xl">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-gray-400 border-b border-white/5">
                        <th class="pb-3 pr-4 font-medium">Nombre</th>
                        <th class="pb-3 pr-4 font-medium">SKU</th>
                        <th class="pb-3 pr-4 font-medium text-center">Stock</th>
                        <th class="pb-3 font-medium text-right">Precio</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    @foreach (var p in viewingProducts)
                    {
                        <tr class="hover:bg-white/3 transition-colors">
                            <td class="py-3 pr-4 text-white font-medium">@p.Name</td>
                            <td class="py-3 pr-4 text-gray-400 font-mono text-xs">@(string.IsNullOrWhiteSpace(p.SKU) ? "—" : p.SKU)</td>
                            <td class="py-3 pr-4 text-center">
                                @if (p.Stock <= p.StockMinimo)
                                {
                                    <span class="inline-flex items-center gap-1 text-[var(--color-danger)] font-semibold">
                                        <i class="bi bi-exclamation-triangle-fill text-xs"></i> @p.Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="text-[var(--color-success)] font-semibold">@p.Stock</span>
                                }
                            </td>
                            <td class="py-3 text-right text-white font-semibold">$@p.Price.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="sticky bottom-0 mt-4 pt-4 border-t border-white/5 flex justify-end bg-[var(--color-card)]">
        <button @onclick="() => isViewProductsOpen = false" class="btn btn-ghost">Cerrar</button>
    </div>
</AppModal>

@code {
    private List<Categoria> items = new();
    private Dictionary<Guid, int> productCounts = new();
    private bool isLoading = true;

    private static readonly string[] CategoryColors =
    [
        "#6366f1", "#8b5cf6", "#ec4899", "#f59e0b",
        "#10b981", "#06b6d4", "#f97316", "#14b8a6"
    ];

    private static string GetCategoryColor(int index) => CategoryColors[index % CategoryColors.Length];
    
    private bool isModalOpen = false;
    private bool isDeleteModalOpen = false;
    private bool isEditMode = false;
    
    private Categoria editingItem = new();
    private Categoria? deletingItem;

    // View products
    private bool isViewProductsOpen = false;
    private Categoria? viewingCategory;
    private List<Producto>? viewingProducts;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            items = await Data.GetCategoriasAsync();
            var allProducts = await Data.GetProductosAsync();
            productCounts = allProducts
                .GroupBy(p => p.CategoryId)
                .ToDictionary(g => g.Key, g => g.Count());
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error al cargar categorías: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenNew()
    {
        editingItem = new Categoria();
        isEditMode = false;
        isModalOpen = true;
    }

    private void OpenEdit(Categoria cat)
    {
        // Clone to edit safely
        editingItem = new Categoria { Id = cat.Id, Name = cat.Name };
        isEditMode = true;
        isModalOpen = true;
    }

    private async Task Save()
    {
        try
        {
            await Data.SaveCategoriaAsync(editingItem);
            var msg = isEditMode ? "Categoría actualizada." : "Categoría creada.";
            Notifications.Success(msg);
            isModalOpen = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error al guardar: {ex.Message}");
        }
    }

    private void OpenDelete(Categoria cat)
    {
        deletingItem = cat;
        isDeleteModalOpen = true;
    }

    private async Task OpenViewProducts(Categoria cat)
    {
        viewingCategory = cat;
        viewingProducts = null;
        isViewProductsOpen = true;
        try
        {
            var all = await Data.GetProductosAsync();
            viewingProducts = all.Where(p => p.CategoryId == cat.Id).OrderBy(p => p.Name).ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error al cargar productos: {ex.Message}");
            viewingProducts = new List<Producto>();
        }
    }

    private async Task ConfirmDelete()
    {
        if (deletingItem == null) return;

        try
        {
            // Bloquear si hay productos asignados a esta categoría
            var allProductos = await Data.GetProductosAsync();
            var productosEnCategoria = allProductos.Count(p => p.CategoryId == deletingItem.Id);
            if (productosEnCategoria > 0)
            {
                var nombre = deletingItem.Name;
                var cant = productosEnCategoria;
                var sufijo = cant == 1 ? "" : "s";
                Notifications.Error($"No se puede eliminar \u2018{nombre}\u2019: tiene {cant} producto{sufijo} asignado{sufijo}. Reasignálos primero.");
                isDeleteModalOpen = false;
                return;
            }

            await Data.DeleteCategoriaAsync(deletingItem.Id);
            Notifications.Success($"Categoría \u2018{deletingItem.Name}\u2019 eliminada.");
            isDeleteModalOpen = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Notifications.Error($"Error al eliminar: {ex.Message}");
            isDeleteModalOpen = false;
        }
    }
}
