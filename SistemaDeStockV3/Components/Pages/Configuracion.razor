@page "/configuracion"
@inject DataService Data
@inject NotificationService Notifications
@inject SistemaDeStockV3.Services.BackupService Backup
@inject PdfService PdfSvc
@inject IJSRuntime JS
@using CommunityToolkit.Maui.Storage
@using Microsoft.Maui.ApplicationModel
@using Microsoft.Maui.Storage
@using Microsoft.Maui.Controls
@using System.IO

<div class="max-w-3xl">
    <div>
        <h2 class="page-title mb-1">Configuración del Sistema</h2>
        <p class="page-subtitle mb-8">Administra los parámetros generales del negocio</p>
    </div>

    @if (isLoading)
    {
        <div class="animate-pulse space-y-4 premium-card p-6">
            <div class="h-10 bg-white/5 rounded w-full"></div>
            <div class="h-10 bg-white/5 rounded w-full"></div>
            <div class="h-10 bg-white/5 rounded w-1/2"></div>
        </div>
    }
    else
    {
        <div class="premium-card p-8">
            <EditForm Model="config" OnValidSubmit="SaveConfig">
                <DataAnnotationsValidator />
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    
                    <!-- Nombre Negocio -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">Nombre del Negocio</label>
                        <InputText @bind-Value="config.NombreNegocio" class="w-full bg-black/20 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)] transition-all" />
                        <ValidationMessage For="() => config.NombreNegocio" class="text-[var(--color-danger)] text-sm mt-1" />
                    </div>

                    <!-- Moneda -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">Moneda (Símbolo)</label>
                        <InputText @bind-Value="config.Moneda" class="w-full bg-black/20 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)] transition-all" />
                        <ValidationMessage For="() => config.Moneda" class="text-[var(--color-danger)] text-sm mt-1" />
                    </div>

                    <!-- Teléfono -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">Teléfono</label>
                        <InputText @bind-Value="config.Telefono" class="w-full bg-black/20 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)] transition-all" />
                        <ValidationMessage For="() => config.Telefono" class="text-[var(--color-danger)] text-sm mt-1" />
                    </div>

                    <!-- Dirección -->
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-300 mb-2">Dirección Completa</label>
                        <InputText @bind-Value="config.DireccionNegocio" class="w-full bg-black/20 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)] transition-all" />
                        <ValidationMessage For="() => config.DireccionNegocio" class="text-[var(--color-danger)] text-sm mt-1" />
                    </div>

                </div>

                <div class="flex justify-end pt-4 border-t border-white/5">
                    <button type="submit" class="btn btn-primary btn-lg flex items-center gap-2" disabled="@isSaving">
                        @if(isSaving)
                        {
                            <i class="bi bi-hourglass-split animate-spin"></i>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-save2"></i>
                            <span>Guardar Cambios</span>
                        }
                    </button>
                </div>
            </EditForm>

            @if (showSuccessMessage)
            {
                <div class="mt-4 p-4 rounded-xl bg-[var(--color-success)]/20 border border-[var(--color-success)]/30 text-[var(--color-success-foreground)] flex items-center gap-3 animate-fade-in">
                    <i class="bi bi-check-circle-fill text-xl"></i>
                    <span>La configuración se ha guardado correctamente. Los cambios en el menú se verán al reiniciar.</span>
                </div>
            }
        </div>

        <div class="premium-card p-8 mt-6">
            <h3 class="text-xl font-bold text-white flex items-center gap-2 border-b border-white/5 pb-4 mb-6">
                <i class="bi bi-file-earmark-richtext text-[var(--color-primary)]"></i>
                Identidad en documentos PDF
            </h3>

            <p class="text-gray-400 mb-6 text-sm">
                El logo y el color de marca se aplican a presupuestos, remitos y estados de cuenta. Los cambios se guardan al instante.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-[1fr_15rem] gap-8">
                <div class="space-y-6">
                    <!-- Logo -->
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">Logo del negocio</label>
                        <div class="h-32 rounded-xl border border-white/10 bg-white flex items-center justify-center p-4 overflow-hidden">
                            @if (logoDataUrl != null)
                            {
                                <img src="@logoDataUrl" alt="Logo del negocio" class="max-h-full max-w-full object-contain" />
                            }
                            else
                            {
                                <div class="text-center text-sm text-gray-500">
                                    <i class="bi bi-image text-2xl block mb-1"></i>
                                    Sin logo: los documentos muestran el nombre del negocio
                                </div>
                            }
                        </div>
                        <div class="flex flex-wrap gap-3 mt-3">
                            <button type="button" class="btn btn-secondary flex items-center gap-2" @onclick="CargarLogo" disabled="@isProcessingLogo">
                                @if (isProcessingLogo)
                                {
                                    <i class="bi bi-arrow-repeat animate-spin"></i>
                                    <span>Procesando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-upload"></i>
                                    <span>@(logoDataUrl == null ? "Cargar logo" : "Cambiar logo")</span>
                                }
                            </button>
                            @if (logoDataUrl != null)
                            {
                                <button type="button" class="btn btn-ghost flex items-center gap-2" @onclick="QuitarLogo" disabled="@isProcessingLogo">
                                    <i class="bi bi-x-lg"></i>
                                    <span>Quitar</span>
                                </button>
                            }
                        </div>
                        <p class="text-xs text-gray-400 mt-2">PNG o JPG. Los márgenes blancos se recortan solos.</p>
                    </div>

                    <!-- Color de marca -->
                    <div>
                        <label for="color-marca" class="block text-sm font-medium text-gray-300 mb-2">Color de marca</label>
                        <div class="flex items-center gap-3">
                            <input id="color-marca" type="color" value="@colorMarca" @onchange="CambiarColor"
                                   class="h-11 w-16 cursor-pointer rounded-lg border border-white/10 bg-transparent p-1" />
                            <span class="font-mono text-sm text-gray-300">@colorMarca</span>
                            @if (colorDetectado)
                            {
                                <span class="text-xs text-gray-400 flex items-center gap-1">
                                    <i class="bi bi-magic"></i> tomado del logo
                                </span>
                            }
                        </div>
                        <p class="text-xs text-gray-400 mt-2">Se usa en la franja superior, el número de documento y los detalles. La estructura queda en gris oscuro para que combine con cualquier logo.</p>
                    </div>
                </div>

                <!-- Vista previa -->
                <div>
                    <span class="block text-sm font-medium text-gray-300 mb-2">Vista previa</span>
                    <button type="button" class="block w-full rounded-lg overflow-hidden border border-white/10 bg-white shadow-lg aspect-[210/297] relative cursor-zoom-in"
                            @onclick="() => previewAmpliada = true" disabled="@(vistaPreviaDataUrl == null)" title="Ver en grande">
                        @if (vistaPreviaDataUrl != null)
                        {
                            <img src="@vistaPreviaDataUrl" alt="Vista previa de un presupuesto" class="w-full h-full object-contain" />
                        }
                        @if (isRenderingPreview)
                        {
                            <div class="absolute inset-0 flex items-center justify-center bg-white/60">
                                <i class="bi bi-arrow-repeat animate-spin text-2xl text-gray-500"></i>
                            </div>
                        }
                    </button>
                    <p class="text-xs text-gray-400 mt-2 text-center">Presupuesto de ejemplo · clic para ampliar</p>
                </div>
            </div>
        </div>

        @if (previewAmpliada && vistaPreviaDataUrl != null)
        {
            <div class="fixed inset-0 z-50 bg-black/70 flex items-center justify-center p-6 cursor-zoom-out" @onclick="() => previewAmpliada = false">
                <img src="@vistaPreviaDataUrl" alt="Vista previa ampliada" class="max-h-full max-w-full rounded-lg shadow-2xl bg-white" />
            </div>
        }

        <div class="premium-card p-8 mt-6">
            <h3 class="text-xl font-bold text-white flex items-center gap-2 border-b border-white/5 pb-4 mb-6">
                <i class="bi bi-cloud-arrow-down text-[var(--color-primary)]"></i>
                Respaldo de Datos (Base de Datos .db)
            </h3>
            
            <p class="text-gray-400 mb-6 text-sm">
                Los respaldos guardan una copia exacta de tu base de datos local en una carpeta (ej. Google Drive), manteniendo los últimos 15 archivos. El sistema intentará uno automático cada 24h mientras la app esté abierta.
            </p>

            <div class="grid gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Carpeta de respaldo</label>
                    <div class="flex flex-col md:flex-row gap-3">
                        <input type="text" class="flex-1 bg-black/20 border border-white/10 rounded-xl px-4 py-3 text-white text-sm" value="@selectedFolderDisplay" readonly />
                        <button type="button" class="btn btn-secondary flex items-center gap-2" @onclick="SeleccionarCarpeta">
                            <i class="bi bi-folder2-open"></i>
                            <span>Seleccionar Carpeta</span>
                        </button>
                    </div>
                    <p class="text-xs text-gray-400 mt-2">Se recomienda elegir una carpeta sincronizada por Google Drive Desktop.</p>
                </div>

                <div class="flex items-center gap-2 text-sm text-gray-300">
                    <i class="bi bi-clock-history text-[var(--color-primary)]"></i>
                    <span>Último respaldo histórico: <strong>@lastBackupText</strong></span>
                </div>
                <div class="flex items-center gap-2 text-sm text-gray-300">
                    <i class="bi bi-calendar-check text-[var(--color-success)]"></i>
                    <span>Último backup de cierre: <strong>@lastClosingBackupText</strong></span>
                </div>

                <div class="flex flex-col sm:flex-row gap-3">
                    <button type="button" class="btn btn-primary flex-1 flex items-center justify-center gap-2" @onclick="RespaldarAhora" disabled="@(!canBackup || isBackingUp || isRestoring)">
                        @if (isBackingUp)
                        {
                            <i class="bi bi-arrow-repeat animate-spin"></i>
                            <span>Generando respaldo...</span>
                        }
                        else
                        {
                            <i class="bi bi-hdd-network"></i>
                            <span>Respaldar ahora</span>
                        }
                    </button>
                    <button type="button" class="btn btn-secondary flex-1 flex items-center justify-center gap-2 !text-[var(--color-warning)] !border-[var(--color-warning)]/30" @onclick="RestaurarBackup" disabled="@isRestoring">
                        @if (isRestoring)
                        {
                            <i class="bi bi-arrow-repeat animate-spin"></i>
                            <span>Restaurando...</span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span>Restaurar backup</span>
                        }
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(alertMessage))
                {
                    <div class="@alertCss">
                        <i class="@alertIcon"></i>
                        <span>@alertMessage</span>
                    </div>
                }
            </div>
        </div>
    }

</div>

@code {
    private ConfiguracionApp config = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showSuccessMessage = false;

    // Backup UI state
    private string selectedFolder = "";
    private string selectedFolderDisplay = "Sin carpeta seleccionada";
    private DateTime? lastBackupUtc = null;
    private string lastBackupText = "Nunca";
    private DateTime? lastClosingBackupUtc = null;
    private string lastClosingBackupText = "Nunca";
    private bool isBackingUp = false;
    private bool isRestoring = false;
    private string alertMessage = "";
    private string alertCss = "";
    private string alertIcon = "";
    private bool canBackup => !string.IsNullOrWhiteSpace(selectedFolder) && Directory.Exists(selectedFolder);

    // Identidad de los PDFs
    private string? logoDataUrl;
    private string colorMarca = ConfiguracionApp.ColorMarcaPredeterminado;
    private bool colorDetectado = false;
    private bool isProcessingLogo = false;
    private string? vistaPreviaDataUrl;
    private bool isRenderingPreview = false;
    private bool previewAmpliada = false;

    private const int TamanoMaximoLogo = 15 * 1024 * 1024;

    /// <summary>Resultado de logoMarca.procesar (wwwroot/js/logo-marca.js).</summary>
    private sealed record LogoProcesado(string DataUrl, string? Color);

    protected override async Task OnInitializedAsync()
    {
        await LoadConfig();
        LoadBackupState();
        _ = ActualizarVistaPreviaAsync();
    }

    private async Task LoadConfig()
    {
        isLoading = true;
        config = await Data.GetConfiguracionAsync() ?? new ConfiguracionApp();
        colorMarca = config.ColorMarca;
        logoDataUrl = config.LogoNegocio is { Length: > 0 } logo
            ? $"data:image/png;base64,{Convert.ToBase64String(logo)}"
            : null;
        isLoading = false;
    }

    private async Task CargarLogo()
    {
        try
        {
            var archivo = await MainThread.InvokeOnMainThreadAsync(() => FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Elegí el logo del negocio",
                FileTypes = FilePickerFileType.Images
            }));
            if (archivo == null) return;

            isProcessingLogo = true;
            StateHasChanged();

            byte[] original;
            await using (var entrada = await archivo.OpenReadAsync())
            using (var memoria = new MemoryStream())
            {
                await entrada.CopyToAsync(memoria);
                original = memoria.ToArray();
            }

            if (original.Length > TamanoMaximoLogo)
            {
                Notifications.Warning("La imagen es demasiado pesada (máximo 15 MB).");
                return;
            }

            var mime = Path.GetExtension(archivo.FileName).ToLowerInvariant() switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".gif" => "image/gif",
                ".bmp" => "image/bmp",
                ".webp" => "image/webp",
                _ => "image/png"
            };

            // El recorte, el redimensionado y la detección de color se hacen con canvas en el WebView.
            var procesado = await JS.InvokeAsync<LogoProcesado>("logoMarca.procesar",
                $"data:{mime};base64,{Convert.ToBase64String(original)}");
            var logo = Convert.FromBase64String(procesado.DataUrl[(procesado.DataUrl.IndexOf(',') + 1)..]);

            if (!PdfService.EsLogoValido(logo))
            {
                Notifications.Error("No se pudo usar esa imagen como logo. Probá con un PNG o JPG.");
                return;
            }

            var color = procesado.Color ?? colorMarca;
            await Data.SaveIdentidadDocumentosAsync(logo, color);

            config.LogoNegocio = logo;
            config.ColorMarca = colorMarca = color;
            logoDataUrl = procesado.DataUrl;
            colorDetectado = procesado.Color != null;

            Notifications.Success(colorDetectado
                ? "Logo guardado. El color de marca se tomó del logo."
                : "Logo guardado.");
            _ = ActualizarVistaPreviaAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error($"No se pudo cargar el logo: {ex.Message}");
        }
        finally
        {
            isProcessingLogo = false;
            StateHasChanged();
        }
    }

    private async Task QuitarLogo()
    {
        try
        {
            await Data.SaveIdentidadDocumentosAsync(null, colorMarca);
            config.LogoNegocio = null;
            logoDataUrl = null;
            colorDetectado = false;
            Notifications.Success("Logo quitado. Los documentos muestran el nombre del negocio.");
            _ = ActualizarVistaPreviaAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error($"No se pudo quitar el logo: {ex.Message}");
        }
    }

    private async Task CambiarColor(ChangeEventArgs e)
    {
        var color = e.Value?.ToString()?.Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(color) || color == colorMarca) return;

        try
        {
            await Data.SaveIdentidadDocumentosAsync(config.LogoNegocio, color);
            config.ColorMarca = colorMarca = color;
            colorDetectado = false;
            _ = ActualizarVistaPreviaAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error($"No se pudo guardar el color: {ex.Message}");
        }
    }

    private async Task ActualizarVistaPreviaAsync()
    {
        isRenderingPreview = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            // Usa lo que está en pantalla (aunque no se haya guardado) para previsualizar nombre y datos.
            var muestra = new ConfiguracionApp
            {
                NombreNegocio = config.NombreNegocio,
                DireccionNegocio = config.DireccionNegocio,
                Telefono = config.Telefono,
                LogoNegocio = config.LogoNegocio,
                ColorMarca = colorMarca
            };
            var png = await Task.Run(() => PdfSvc.GenerarVistaPreviaPresupuesto(muestra));
            vistaPreviaDataUrl = $"data:image/png;base64,{Convert.ToBase64String(png)}";
        }
        catch (Exception ex)
        {
            vistaPreviaDataUrl = null;
            Notifications.Error($"No se pudo generar la vista previa: {ex.Message}");
        }
        finally
        {
            isRenderingPreview = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveConfig()
    {
        isSaving = true;
        showSuccessMessage = false;
        try
        {
            await Data.SaveConfiguracionAsync(config);
            await Task.Delay(300);
            isSaving = false;
            showSuccessMessage = true;
            Notifications.Success("Configuración guardada correctamente.");
            _ = ActualizarVistaPreviaAsync(); // el nombre, la dirección y el teléfono salen en los PDFs
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                showSuccessMessage = false;
                await InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            isSaving = false;
            Notifications.Error($"Error al guardar: {ex.Message}");
        }
    }

    private void LoadBackupState()
    {
        selectedFolder = Backup.GetConfiguredFolder();
        selectedFolderDisplay = selectedFolder == Backup.CarpetaPredeterminada
            ? $"{selectedFolder} (predeterminada)"
            : selectedFolder;

        lastBackupUtc = Backup.GetLastBackupUtc();
        lastBackupText = lastBackupUtc.HasValue
            ? TimeZoneInfo.ConvertTimeFromUtc(lastBackupUtc.Value, TimeZoneInfo.Local).ToString("dd/MM/yyyy HH:mm")
            : "Nunca";

        lastClosingBackupUtc = Backup.GetLastClosingBackupUtc();
        lastClosingBackupText = lastClosingBackupUtc.HasValue
            ? TimeZoneInfo.ConvertTimeFromUtc(lastClosingBackupUtc.Value, TimeZoneInfo.Local).ToString("dd/MM/yyyy HH:mm")
            : "Nunca";
    }

    private async Task SeleccionarCarpeta()
    {
        try
        {
            var pickResult = await MainThread.InvokeOnMainThreadAsync(async () =>
            {
                return await FolderPicker.Default.PickAsync("Seleccione carpeta de respaldo");
            });

            if (pickResult == null || string.IsNullOrWhiteSpace(pickResult.Folder?.Path))
                return;

            selectedFolder = pickResult.Folder.Path;
            selectedFolderDisplay = selectedFolder;

            Preferences.Set("Backup.TargetFolder", selectedFolder);
            alertMessage = "";

            Notifications.Success("Carpeta de respaldo guardada.");
        }
        catch (Exception ex)
        {
            Notifications.Error($"No se pudo seleccionar la carpeta: {ex.Message}");
        }

        StateHasChanged();
    }

    private async Task RespaldarAhora()
    {
        if (!canBackup)
        {
            Notifications.Warning("Configura primero una carpeta de respaldo.");
            return;
        }

        isBackingUp = true;
        alertMessage = "";
        StateHasChanged();

        var result = await Backup.ExecuteBackupToFolderAsync(selectedFolder, isAutomatic: false);

        isBackingUp = false;

        if (result.Success)
        {
            Notifications.Success("Backup creado correctamente.");
            lastBackupUtc = DateTime.UtcNow;
            lastBackupText = TimeZoneInfo.ConvertTimeFromUtc(lastBackupUtc.Value, TimeZoneInfo.Local).ToString("dd/MM/yyyy HH:mm");
            alertMessage = "Backup generado y guardado en la carpeta configurada.";
            alertCss = "mt-2 p-3 rounded-lg bg-[var(--color-success)]/15 border border-[var(--color-success)]/30 text-[var(--color-success-foreground)] flex items-center gap-2";
            alertIcon = "bi bi-check-circle-fill";
        }
        else
        {
            Notifications.Error(result.Message);
            alertMessage = result.Message;
            alertCss = "mt-2 p-3 rounded-lg bg-[var(--color-danger)]/15 border border-[var(--color-danger)]/30 text-[var(--color-danger-foreground)] flex items-center gap-2";
            alertIcon = "bi bi-exclamation-triangle-fill";
        }

        StateHasChanged();
    }

    private async Task RestaurarBackup()
    {
        isRestoring = true;
        alertMessage = "";
        StateHasChanged();

        var result = await Backup.RestoreBackupAsync();

        if (result.Success)
        {
            alertMessage = $"{result.Message} La aplicación se cerrará en 5 segundos: al abrirla de nuevo vas a ver los datos restaurados.";
            alertCss = "mt-2 p-3 rounded-lg bg-[var(--color-success)]/15 border border-[var(--color-success)]/30 text-[var(--color-success-foreground)] flex items-center gap-2";
            alertIcon = "bi bi-check-circle-fill";
            Notifications.Success("Datos restaurados. Cerrando la aplicación...");
            StateHasChanged();
            // isRestoring sigue en true: los botones quedan deshabilitados hasta el cierre
            await Task.Delay(5000);
            Application.Current?.Quit();
            return;
        }
        else
        {
            alertMessage = result.Message;
            alertCss = "mt-2 p-3 rounded-lg bg-[var(--color-danger)]/15 border border-[var(--color-danger)]/30 text-[var(--color-danger-foreground)] flex items-center gap-2";
            alertIcon = "bi bi-exclamation-triangle-fill";
            Notifications.Error($"Error al restaurar: {result.Message}");
        }

        isRestoring = false;
        StateHasChanged();
    }
}
