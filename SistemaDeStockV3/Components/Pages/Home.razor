@page "/"
@page "/dashboard"
@using SistemaDeStockV3.Models
@inject DataService Data
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="dashboard-shell">

    <div class="dashboard-hero">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-[11px] font-extrabold uppercase tracking-[0.28em] text-[var(--color-primary)] mb-1">Panel Principal</p>
                <h2 class="text-2xl font-extrabold text-[var(--color-text-primary)] tracking-tight">Dashboard</h2>
                <p class="text-sm text-[var(--color-text-secondary)] mt-0.5">Resumen general del negocio al instante.</p>
            </div>

            <div @onclick="OpenSearchAsync" class="dashboard-search-shell w-full sm:w-72 cursor-pointer hover:bg-[var(--color-surface)] transition-colors">
                <i class="bi bi-search text-[var(--color-neutral)] text-sm"></i>
                <span class="text-sm text-[var(--color-text-secondary)]">Buscar (Ctrl+K)...</span>
            </div>
        </div>
    </div>

    @* Acciones Rápidas *@
    <div class="flex flex-wrap items-center gap-3 animate-fade-in -mt-3">
        <button @onclick='() => Nav.NavigateTo("/ventas")' class="btn btn-primary">
            <i class="bi bi-plus-circle text-base"></i> Nueva Venta
        </button>
        <button @onclick='() => Nav.NavigateTo("/productos")' class="btn btn-secondary">
            <i class="bi bi-box-seam text-[var(--color-primary)] text-base"></i> Nuevo Producto
        </button>
        <button @onclick='() => Nav.NavigateTo("/finanzas")' class="btn btn-secondary">
            <i class="bi bi-cash-stack text-[var(--color-warning)] text-base"></i> Registrar Gasto
        </button>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <strong class="font-bold">Error!</strong>
            <span class="block sm:inline whitespace-pre-wrap">@ErrorMessage</span>
        </div>
    }

    @if (isLoading)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
            @for (int i = 0; i < 4; i++)
            {
                <div class="dashboard-stat-card min-h-[140px] animate-pulse bg-[var(--color-neutral)]/10"></div>
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">

            @* Ventas Hoy — primary *@
            <div class="dashboard-stat-card group" style="border-left: 4px solid var(--color-primary)">
                <div class="absolute inset-0 bg-[var(--color-primary)]/0 group-hover:bg-[var(--color-primary)]/[0.025] transition-colors rounded-[1.5rem] pointer-events-none"></div>
                <div class="relative z-10">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-11 h-11 rounded-xl bg-[var(--color-primary)]/10 flex items-center justify-center">
                            <i class="bi bi-cart-check text-xl text-[var(--color-primary)]"></i>
                        </div>
                        <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--color-text-secondary)] text-right leading-tight">Ventas<br/>Hoy</span>
                    </div>
                    <h3 class="text-3xl font-extrabold text-[var(--color-text-primary)] mb-1 tabular-nums">@VentasHoy.ToString("C0")</h3>
                    <p class="text-xs font-semibold text-[var(--color-primary)] flex items-center gap-1">
                        <i class="bi bi-graph-up"></i> @CantidadVentasHoy transacciones
                    </p>
                </div>
            </div>

            @* Deuda Clientes — warning *@
            <div class="dashboard-stat-card group" style="border-left: 4px solid var(--color-warning)">
                <div class="absolute inset-0 bg-[var(--color-warning)]/0 group-hover:bg-[var(--color-warning)]/[0.025] transition-colors rounded-[1.5rem] pointer-events-none"></div>
                <div class="relative z-10">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-11 h-11 rounded-xl bg-[var(--color-warning)]/10 flex items-center justify-center">
                            <i class="bi bi-wallet2 text-xl text-[var(--color-warning)]"></i>
                        </div>
                        <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--color-text-secondary)] text-right leading-tight">Deuda<br/>Clientes</span>
                    </div>
                    <h3 class="text-3xl font-extrabold text-[var(--color-text-primary)] mb-1 tabular-nums">@TotalDeuda.ToString("C0")</h3>
                    <p class="text-xs text-[var(--color-text-secondary)]">Capital por cobrar</p>
                </div>
            </div>

            @* Valor Inventario — info, con formato compacto *@
            <div class="dashboard-stat-card group" style="border-left: 4px solid var(--color-info)">
                <div class="absolute inset-0 bg-[var(--color-info)]/0 group-hover:bg-[var(--color-info)]/[0.025] transition-colors rounded-[1.5rem] pointer-events-none"></div>
                <div class="relative z-10">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-11 h-11 rounded-xl bg-[var(--color-info)]/10 flex items-center justify-center">
                            <i class="bi bi-archive-fill text-xl text-[var(--color-info)]"></i>
                        </div>
                        <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--color-text-secondary)] text-right leading-tight">Valor<br/>Inventario</span>
                    </div>
                    <h3 class="text-3xl font-extrabold text-[var(--color-text-primary)] mb-0.5 tabular-nums">@FormatearCompacto(ValorInventario)</h3>
                    <p class="text-xs text-[var(--color-text-secondary)]">@ValorInventario.ToString("N0") total</p>
                </div>
            </div>

            @* Productos — success/danger según stock *@
            @{
                var stockColor = ProductosBajoStock.Any() ? "var(--color-danger)" : "var(--color-success)";
                var stockBg = ProductosBajoStock.Any() ? "bg-[var(--color-danger)]/10" : "bg-[var(--color-success)]/10";
                var stockIcon = ProductosBajoStock.Any() ? "text-[var(--color-danger)]" : "text-[var(--color-success)]";
            }
            <div class="dashboard-stat-card group" style="border-left: 4px solid @stockColor">
                <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity rounded-[1.5rem] pointer-events-none" style="background: color-mix(in srgb, @stockColor 3%, transparent)"></div>
                <div class="relative z-10">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-11 h-11 rounded-xl @stockBg flex items-center justify-center">
                            <i class="bi bi-box-fill text-xl @stockIcon"></i>
                        </div>
                        <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--color-text-secondary)] text-right leading-tight">Total<br/>Productos</span>
                    </div>
                    <h3 class="text-3xl font-extrabold text-[var(--color-text-primary)] mb-1 tabular-nums">@TotalProductos</h3>
                    <p class="text-xs flex items-center gap-1 font-semibold @(ProductosBajoStock.Any() ? "text-[var(--color-danger)]" : "text-[var(--color-success)]")">
                        @if (ProductosBajoStock.Any())
                        {
                            <i class="bi bi-exclamation-triangle"></i> <span>@ProductosBajoStock.Count bajo stock</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle"></i> <span>Stock saludable</span>
                        }
                    </p>
                </div>
            </div>

        </div>

        @* CHART — empty state hasta tener datos históricos reales *@
        <div class="dashboard-stat-card mb-5 p-0 overflow-hidden">
            <div class="p-6 pb-0 flex items-center justify-between">
                <div>
                    <h3 class="font-extrabold text-[var(--color-text-primary)] text-lg">Evolución de Ingresos</h3>
                    <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-[var(--color-text-secondary)] mt-0.5">Últimos 7 días</p>
                </div>
            </div>

            @if (CantidadVentasHoy == 0 && !UltimosMovimientos.Any())
            {
                @* Empty state: sin ventas aún *@
                <div class="relative px-6 pb-8 pt-4">
                    @* Ghost chart SVG *@
                    <div class="absolute inset-0 overflow-hidden pointer-events-none px-6 pt-4 pb-8">
                        <svg viewBox="0 0 600 120" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-full">
                            <defs>
                                <linearGradient id="chartGhost" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0.06"/>
                                    <stop offset="100%" stop-color="var(--color-primary)" stop-opacity="0"/>
                                </linearGradient>
                            </defs>
                            <path d="M0,90 C60,80 120,55 180,62 C240,68 300,30 360,38 C420,46 480,18 600,24 L600,120 L0,120 Z"
                                  fill="url(#chartGhost)"/>
                            <path d="M0,90 C60,80 120,55 180,62 C240,68 300,30 360,38 C420,46 480,18 600,24"
                                  stroke="var(--color-primary)" stroke-width="2.5" fill="none"
                                  stroke-dasharray="6,5" opacity="0.18"/>
                            @* Puntos del ghost *@
                            @foreach (var (cx, cy) in new[]{(0,90),(100,70),(200,62),(300,30),(400,38),(500,18),(600,24)})
                            {
                                <circle cx="@cx" cy="@cy" r="4" fill="white" stroke="var(--color-primary)" stroke-width="2" opacity="0.18"/>
                            }
                        </svg>
                    </div>

                    @* Contenido central *@
                    <div class="relative z-10 flex flex-col items-center justify-center py-8 text-center gap-3">
                        <div class="w-14 h-14 rounded-2xl bg-[var(--color-primary)]/8 flex items-center justify-center mb-1">
                            <i class="bi bi-graph-up-arrow text-2xl text-[var(--color-primary)]/50"></i>
                        </div>
                        <p class="text-sm font-semibold text-[var(--color-text-primary)]">El gráfico aparecerá con tus primeras ventas</p>
                        <p class="text-xs text-[var(--color-text-secondary)] max-w-xs">Registrá una venta para comenzar a ver la evolución de ingresos de los últimos 7 días.</p>
                        <button @onclick='() => Nav.NavigateTo("/ventas")' class="btn btn-primary btn-sm mt-1">
                            <i class="bi bi-plus-circle"></i> Nueva Venta
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="px-3 pb-3">
                    <DashboardChart Labels="@ChartLabels" Data="@ChartData" />
                </div>
            }
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

            @* Rotación Anual *@
            <div class="dashboard-highlight-card p-6 group relative overflow-hidden">
                <div class="absolute -right-5 -top-5 text-[var(--color-primary)] opacity-[0.05] group-hover:opacity-[0.09] transition-opacity">
                    <i class="bi bi-arrow-repeat text-9xl"></i>
                </div>
                <div class="relative z-10">
                    <div class="flex items-center justify-between mb-3">
                        <p class="text-[10px] font-extrabold uppercase tracking-[0.18em] text-[var(--color-text-secondary)]">Rotación Anual</p>
                        <i class="bi bi-info-circle text-[var(--color-neutral)] cursor-help text-xs"
                           title="Veces que el inventario completo se vendió y repuso en el último año"></i>
                    </div>
                    <h3 class="text-3xl font-extrabold text-[var(--color-text-primary)] mb-1">@RotacionAnual.ToString("N2")</h3>
                    <div class="flex items-center gap-2">
                        <p class="text-xs text-[var(--color-text-secondary)]">veces/año</p>
                        @if (RotacionAnual < 2)
                        {
                            <span class="px-2 py-0.5 rounded-full text-xs bg-[var(--color-warning-bg)] text-[var(--color-warning-foreground)] border border-[var(--color-warning)]/25 font-semibold">Baja rotación</span>
                        }
                        else if (RotacionAnual >= 6)
                        {
                            <span class="px-2 py-0.5 rounded-full text-xs bg-[var(--color-success-bg)] text-[var(--color-success-foreground)] border border-[var(--color-success)]/25 font-semibold">Buena rotación</span>
                        }
                    </div>
                </div>
            </div>

            @* Top 5 baja rotación *@
            <div class="dashboard-highlight-card lg:col-span-2">
                <div class="px-6 py-4 border-b border-[var(--color-border)] flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i class="bi bi-hourglass-split text-[var(--color-warning)]"></i>
                        <h3 class="font-semibold text-[var(--color-text-primary)] text-sm">Top 5 baja rotación</h3>
                    </div>
                    <a class="text-[var(--color-primary)] text-xs font-semibold hover:underline" href="variacion-precios">Ver análisis completo</a>
                </div>
                <div class="p-5 space-y-2">
                    @if (!TopRotacionBaja.Any())
                    {
                        <div class="flex flex-col items-center justify-center py-8 text-center gap-2">
                            <div class="w-12 h-12 rounded-xl bg-[var(--color-success)]/10 flex items-center justify-center mb-1">
                                <i class="bi bi-check2-circle text-2xl text-[var(--color-success)]"></i>
                            </div>
                            <p class="text-sm font-semibold text-[var(--color-text-primary)]">Todos los productos rotan bien</p>
                            <p class="text-xs text-[var(--color-text-secondary)]">No hay productos con baja rotación en este momento.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in TopRotacionBaja)
                        {
                            <div class="dashboard-surface flex items-center justify-between gap-4 text-sm px-4 py-3">
                                <div class="flex-1">
                                    <div class="text-[var(--color-text-primary)] font-semibold truncate">@item.Nombre</div>
                                    <div class="text-[10px] text-[var(--color-text-secondary)]">Stock: @item.StockActual | Ventas 12m: @item.UnidadesVendidas12m</div>
                                </div>
                                <div class="text-right">
                                    <div class="text-[var(--color-warning-foreground)] font-bold">@item.Rotacion.ToString("N2")</div>
                                    <div class="text-[10px] text-[var(--color-text-secondary)]">Días sin venta: @item.DiasSinVenta</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

            @* Alertas de Stock *@
            <div class="dashboard-highlight-card lg:col-span-2 flex flex-col" style="height:400px">
                <div class="px-6 py-4 border-b border-[var(--color-border)] flex items-center gap-2">
                    <i class="bi bi-bell-fill text-[var(--color-warning)]"></i>
                    <h3 class="font-semibold text-[var(--color-text-primary)]">Alertas de Stock</h3>
                </div>
                <div class="flex-1 overflow-y-auto">
                    @if (!ProductosBajoStock.Any())
                    {
                        <div class="flex flex-col items-center justify-center h-full py-10 text-center gap-2">
                            <div class="w-14 h-14 rounded-2xl bg-[var(--color-success)]/10 flex items-center justify-center mb-1">
                                <i class="bi bi-shield-check text-2xl text-[var(--color-success)]"></i>
                            </div>
                            <p class="text-sm font-semibold text-[var(--color-text-primary)]">Stock en niveles óptimos</p>
                            <p class="text-xs text-[var(--color-text-secondary)] max-w-[180px]">Todos los productos están por encima de su mínimo configurado.</p>
                        </div>
                    }
                    else
                    {
                        <table class="w-full text-left whitespace-nowrap">
                            <thead class="sticky top-0 z-10">
                                <tr class="text-xs text-[var(--color-text-secondary)]">
                                    <th class="px-6 py-3 font-semibold">Producto</th>
                                    <th class="px-6 py-3 font-semibold text-right">Stock</th>
                                    <th class="px-6 py-3 font-semibold text-right">Mínimo</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[var(--color-border)]">
                                @foreach (var p in ProductosBajoStock)
                                {
                                    <tr class="hover:bg-[var(--color-primary)]/4 transition-colors">
                                        <td class="px-6 py-3">
                                            <div class="font-medium text-[var(--color-text-primary)] text-sm">@p.Name</div>
                                            <div class="text-xs text-[var(--color-text-secondary)] font-mono">@p.SKU</div>
                                        </td>
                                        <td class="px-6 py-3 text-right">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-[var(--color-danger-bg)] text-[var(--color-danger)] border border-[var(--color-danger)]/20">
                                                @p.Stock u.
                                            </span>
                                        </td>
                                        <td class="px-6 py-3 text-right text-[var(--color-text-secondary)] text-sm">
                                            @p.StockMinimo u.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            @* Actividad Reciente *@
            <div class="dashboard-highlight-card flex flex-col" style="height:400px">
                <div class="px-6 py-4 border-b border-[var(--color-border)] flex items-center gap-2">
                    <i class="bi bi-clock-history text-[var(--color-primary)]"></i>
                    <h3 class="font-semibold text-[var(--color-text-primary)]">Actividad Reciente</h3>
                </div>
                <div class="p-6 flex-1 overflow-y-auto">
                    @if (!UltimosMovimientos.Any())
                    {
                        <div class="flex flex-col items-center justify-center h-full py-6 text-center gap-3">
                            @* Timeline placeholder visual *@
                            <div class="flex flex-col gap-2 opacity-20 mb-2 pointer-events-none" aria-hidden="true">
                                @for (int i = 0; i < 3; i++)
                                {
                                    <div class="flex items-center gap-3 pl-1">
                                        <div class="w-5 h-5 rounded-full border-2 border-[var(--color-border)] bg-[var(--color-surface)]"></div>
                                        <div class="h-2 rounded-full bg-[var(--color-border)]" style="width: @(60 + i * 20)px"></div>
                                    </div>
                                }
                            </div>
                            <div class="w-11 h-11 rounded-xl bg-[var(--color-primary)]/8 flex items-center justify-center">
                                <i class="bi bi-clock-history text-xl text-[var(--color-primary)]/40"></i>
                            </div>
                            <p class="text-sm font-semibold text-[var(--color-text-primary)]">Sin actividad hoy</p>
                            <p class="text-xs text-[var(--color-text-secondary)]">Las ventas e ingresos<br/>registrados aparecerán acá.</p>
                            <button @onclick='() => Nav.NavigateTo("/finanzas")' class="btn btn-ghost btn-sm mt-1">
                                <i class="bi bi-plus"></i> Registrar movimiento
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-5">
                            @foreach (var m in UltimosMovimientos.Take(10))
                            {
                                <div class="relative pl-6">
                                    <div class="absolute left-[11px] top-6 bottom-[-20px] w-px bg-[var(--color-border)] last:hidden"></div>
                                    <div class="absolute left-0 top-1 w-[22px] h-[22px] rounded-full flex items-center justify-center bg-white border-2 border-[var(--color-border)] z-10">
                                        <div class="w-2 h-2 rounded-full @(m.Type == TipoMovimiento.Ingreso ? "bg-[var(--color-success)]" : "bg-[var(--color-danger)]")"></div>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-[var(--color-text-primary)]">@m.Description</p>
                                        <div class="flex items-center justify-between mt-1">
                                            <p class="text-xs text-[var(--color-text-secondary)]">@m.Date.ToString("HH:mm")</p>
                                            <p class="text-xs font-bold @(m.Type == TipoMovimiento.Ingreso ? "text-[var(--color-success)]" : "text-[var(--color-danger)]")">
                                                @(m.Type == TipoMovimiento.Ingreso ? "+" : "-")@m.Amount.ToString("C")
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>
    }

</div>

@code {
    private bool isLoading = true;

    private decimal VentasHoy = 0;
    private int CantidadVentasHoy = 0;
    private decimal TotalDeuda = 0;
    private decimal ValorInventario = 0;
    private int TotalProductos = 0;
    private double RotacionAnual = 0;
    private List<Producto> ProductosBajoStock = new();
    private List<MovimientoFinanciero> UltimosMovimientos = new();
    private List<RotacionProductoDto> TopRotacionBaja = new();

    private List<string> ChartLabels = new() { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" };
    private List<double> ChartData = new() { 12500, 15300, 14200, 22000, 18500, 29000, 11400 };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task OpenSearchAsync()
    {
        await JS.InvokeVoidAsync("eval", "if(window.appUI && window.appUI.layoutRef) window.appUI.layoutRef.invokeMethodAsync('OpenGlobalSearch')");
    }

    private string ErrorMessage = string.Empty;

    private string FormatearCompacto(decimal valor)
    {
        if (valor >= 1_000_000_000) return $"${valor / 1_000_000_000:N1}B";
        if (valor >= 1_000_000)     return $"${valor / 1_000_000:N1}M";
        if (valor >= 1_000)         return $"${valor / 1_000:N0}K";
        return valor.ToString("C0");
    }

    private async Task LoadData()
    {
        isLoading = true;
        ErrorMessage = string.Empty;

        try
        {
            var data = await Data.GetDashboardDataAsync();

            VentasHoy = data.TotalVentas;
            CantidadVentasHoy = data.CantidadVentas;
            TotalDeuda = data.TotalDeuda;
            ValorInventario = data.ValorInventario;
            TotalProductos = data.TotalProductos;
            ProductosBajoStock = data.BajoStock;
            UltimosMovimientos = data.UltimosMovimientos;

            RotacionAnual = await Data.CalcularRotacionAnualAsync();
            TopRotacionBaja = await Data.GetRotacionProductosAsync(null, null, true, 5);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error cargando datos: {ex.Message} \n {ex.StackTrace}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
