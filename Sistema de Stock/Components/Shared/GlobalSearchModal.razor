@using Sistema_de_Stock.Models
@using Sistema_de_Stock.Services
@inject IJSRuntime JSRuntime
@inject DataService Data
@inject NavigationManager Nav

@if (IsOpen)
{
    <div class="fixed inset-0 z-[5000] flex items-start justify-center pt-[10vh] px-4 backdrop-blur-sm bg-black/40 animate-fade-in" @onclick="Close">
        <div class="w-full max-w-2xl bg-[var(--color-surface)] rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.3)] border border-[var(--color-border)] overflow-hidden flex flex-col" @onclick:stopPropagation>
            <div class="flex items-center px-4 py-1 border-b border-[var(--color-line)]">
                <i class="bi bi-search text-[var(--color-primary)] text-xl"></i>
                <input @ref="searchInput" type="text" @bind="SearchQuery" @bind:event="oninput" placeholder="Buscar productos, clientes, reportes..." class="flex-1 bg-transparent border-none py-4 px-4 text-xl font-medium text-[var(--color-ink)] focus:outline-none placeholder-[var(--color-muted)]" />
                <button @onclick="Close" class="text-[11px] font-bold px-2 py-1 rounded bg-[var(--color-bg)] text-[var(--color-muted)] border border-[var(--color-border)] hover:bg-[var(--color-line)] transition-colors">ESC</button>
            </div>
            
            <div class="max-h-[50vh] overflow-y-auto p-2">
                @if (string.IsNullOrWhiteSpace(SearchQuery))
                {
                    <div class="p-10 text-center text-[var(--color-muted)]">
                        <i class="bi bi-command text-4xl mb-4 block opacity-50"></i>
                        <p class="text-sm">Escribe algo para comenzar a buscar.</p>
                        <p class="text-xs mt-2 opacity-70">Puedes buscar por código, nombre o categoría.</p>
                    </div>
                }
                else if (isSearching)
                {
                    <div class="p-10 text-center text-[var(--color-muted)] flex flex-col items-center justify-center">
                        <i class="bi bi-arrow-repeat animate-spin text-3xl mb-3"></i>
                        <p class="text-sm font-medium">Buscando resultados...</p>
                    </div>
                }
                else if (searchResults.Any())
                {
                    <div class="p-2 space-y-1">
                        <p class="text-[10px] font-bold text-[var(--color-muted)] px-3 py-2 uppercase tracking-[0.2em]">Productos (@searchResults.Count resultados)</p>
                        @foreach (var prod in searchResults)
                        {
                            <button @onclick="() => NavigateToProduct(prod)" class="w-full text-left flex justify-between items-center px-4 py-3 rounded-xl hover:bg-[var(--color-bg)] transition-colors group">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-[var(--color-primary)]/10 flex items-center justify-center text-[var(--color-primary)]">
                                        <i class="bi bi-box-seam"></i>
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-[var(--color-ink)]">@prod.Name</p>
                                        <p class="text-xs text-[var(--color-muted)]">Cód: @(string.IsNullOrEmpty(prod.SKU) ? "S/N" : prod.SKU) &middot; Stock: @prod.Stock &middot; <strong class="text-[var(--color-primary)] font-medium">$@prod.Price.ToString("N2")</strong></p>
                                    </div>
                                </div>
                                <span class="opacity-0 group-hover:opacity-100 text-[10px] font-bold bg-[var(--color-primary)] text-white px-2 py-1 rounded truncate transition-opacity flex items-center gap-1">
                                    <i class="bi bi-arrow-return-left"></i> VER PRODUCTOS
                                </span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="p-10 text-center text-[var(--color-muted)]">
                        <i class="bi bi-emoji-frown text-4xl mb-4 block opacity-50"></i>
                        <p class="text-sm font-medium">No se encontraron resultados para "@SearchQuery"</p>
                        <button @onclick='() => NavigateToUrl("/productos")' class="mt-4 px-4 py-2 bg-[var(--color-primary)]/10 text-[var(--color-primary)] rounded-lg text-sm font-bold hover:bg-[var(--color-primary)]/20 transition-colors">
                            Ir a Catálogo de Productos
                        </button>
                    </div>
                }
            </div>
            
            <div class="bg-[var(--color-bg)] border-t border-[var(--color-line)] px-5 py-3 flex items-center justify-between text-[11px] text-[var(--color-muted)] font-medium">
                <div class="flex gap-4">
                    <span class="flex items-center gap-2"><kbd class="font-sans bg-[var(--color-surface)] border border-[var(--color-border)] px-1.5 py-0.5 rounded shadow-sm text-[10px]">↑</kbd> <kbd class="font-sans bg-[var(--color-surface)] border border-[var(--color-border)] px-1.5 py-0.5 rounded shadow-sm text-[10px]">↓</kbd> Navegar</span>
                    <span class="flex items-center gap-2"><kbd class="font-sans bg-[var(--color-surface)] border border-[var(--color-border)] px-1.5 py-0.5 rounded shadow-sm text-[10px]">Enter</kbd> Seleccionar</span>
                </div>
                <span>Búsqueda Acelerada</span>
            </div>
        </div>
    </div>
}

@code {
    public bool IsOpen { get; private set; }
    
    private string _searchQuery = "";
    public string SearchQuery 
    { 
        get => _searchQuery; 
        set 
        {
            if (_searchQuery != value)
            {
                _searchQuery = value;
                if (searchTimer != null)
                {
                    searchTimer.Stop();
                    searchTimer.Start();
                }
            }
        } 
    }
    
    private ElementReference searchInput;
    private System.Timers.Timer? searchTimer;
    private bool isSearching = false;
    private List<Producto> searchResults = new();

    protected override void OnInitialized()
    {
        searchTimer = new System.Timers.Timer(500); // 500ms debounce
        searchTimer.Elapsed += async (sender, e) => await SearchOnServer();
        searchTimer.AutoReset = false;
    }

    private async Task SearchOnServer()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            searchResults.Clear();
            await InvokeAsync(StateHasChanged);
            return;
        }

        isSearching = true;
        await InvokeAsync(StateHasChanged);

        try 
        {
            // Traer max 5 parecidos
            searchResults = await Data.GetProductosPaginadosAsync(1, 5, _searchQuery);
        }
        catch { }
        
        isSearching = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task Show()
    {
        IsOpen = true;
        _searchQuery = "";
        searchResults.Clear();
        StateHasChanged();
        await Task.Delay(50); // Esperar render
        try { await searchInput.FocusAsync(); } catch { }
    }

    public void Close()
    {
        IsOpen = false;
        StateHasChanged();
    }
    
    private void NavigateToProduct(Producto product)
    {
        // For now, redirect to global products page. In the future, this can accept an ID parameter,
        // or trigger a specific modal via app state.
        NavigateToUrl("/productos");
    }

    private void NavigateToUrl(string url)
    {
        Close();
        Nav.NavigateTo(url);
    }
}
