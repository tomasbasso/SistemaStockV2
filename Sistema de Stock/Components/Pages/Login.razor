@page "/login"
@inject SupabaseAuthService AuthService
@inject TenantService TenantService
@inject ConnectivityService Connectivity
@inject NavigationManager Nav

<div class="login-wrapper">
    <div class="login-card">

        <!-- Logo / Header -->
        <div class="login-header">
            <div class="login-logo">
                <span class="logo-icon">📦</span>
            </div>
            <h1 class="login-title">Sistema de Stock</h1>
            <p class="login-subtitle">Gestión inteligente para tu negocio</p>
        </div>

        <!-- Estado de conectividad -->
        @if (!Connectivity.IsOnline)
        {
            <div class="alert alert-warning offline-alert">
                <span class="alert-icon">⚠️</span>
                <div>
                    <strong>Sin conexión a internet</strong>
                    <p>Necesitás conectarte al menos una vez para ingresar.</p>
                </div>
            </div>
        }

        <!-- Formulario de Login -->
        @if (!_showOfflineOption)
        {
            <div class="login-form">
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email"
                           class="form-input @(HasError ? "input-error" : "")"
                           placeholder="tu@negocio.com"
                           @bind="_email"
                           @bind:event="oninput"
                           disabled="@_loading" />
                </div>

                <div class="form-group">
                    <label class="form-label">Contraseña</label>
                    <div class="password-wrapper">
                        <input type="@(_showPassword ? "text" : "password")"
                               class="form-input @(HasError ? "input-error" : "")"
                               placeholder="••••••••"
                               @bind="_password"
                               @bind:event="oninput"
                               @onkeydown="HandleKeyDown"
                               disabled="@_loading" />
                        <button class="toggle-password" type="button" @onclick="() => _showPassword = !_showPassword">
                            @(_showPassword ? "🙈" : "👁️")
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-error">
                        <span>❌</span> @_errorMessage
                    </div>
                }

                <button class="btn-login @(_loading ? "btn-loading" : "")"
                        @onclick="HandleLogin"
                        disabled="@(_loading || !Connectivity.IsOnline)">
                    @if (_loading)
                    {
                        <span class="spinner"></span>
                        <span>Ingresando...</span>
                    }
                    else
                    {
                        <span>Ingresar</span>
                    }
                </button>
            </div>
        }

        <!-- Opción offline (solo si ya hubo login previo y ahora no hay internet) -->
        @if (_showOfflineOption)
        {
            <div class="offline-session">
                <div class="offline-icon">📵</div>
                <p>Tu sesión está guardada. Podés continuar en modo solo lectura.</p>
                <div class="offline-tenant-info">
                    <strong>@_savedTenantName</strong>
                    <span>@_savedEmail</span>
                </div>
                <button class="btn-login btn-offline" @onclick="ContinueOffline">
                    Continuar sin internet (solo lectura)
                </button>
                <button class="btn-link" @onclick="() => _showOfflineOption = false">
                    Intentar conectar
                </button>
            </div>
        }

        <div class="login-footer">
            <span>Sistema de Stock Retail v1.0</span>
        </div>
    </div>
</div>

<style>
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
        padding: 1rem;
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 24px;
        padding: 2.5rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.5);
        animation: slideUp 0.4s ease;
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .login-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .login-logo {
        width: 72px;
        height: 72px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 1rem;
        box-shadow: 0 8px 24px rgba(102, 126, 234, 0.4);
    }

    .login-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #fff;
        margin: 0 0 0.3rem;
    }

    .login-subtitle {
        font-size: 0.9rem;
        color: rgba(255,255,255,0.5);
        margin: 0;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

    .form-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 500;
        color: rgba(255,255,255,0.7);
        margin-bottom: 0.4rem;
    }

    .form-input {
        width: 100%;
        padding: 0.75rem 1rem;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 12px;
        color: #fff;
        font-size: 0.95rem;
        transition: all 0.2s;
        box-sizing: border-box;
        outline: none;
    }

    .form-input:focus {
        border-color: #667eea;
        background: rgba(102, 126, 234, 0.1);
        box-shadow: 0 0 0 3px rgba(102,126,234,0.2);
    }

    .form-input::placeholder { color: rgba(255,255,255,0.3); }
    .form-input.input-error { border-color: #ff6b6b; }
    .form-input:disabled { opacity: 0.5; cursor: not-allowed; }

    .password-wrapper {
        position: relative;
    }

    .toggle-password {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.1rem;
        padding: 0;
        opacity: 0.7;
    }

    .toggle-password:hover { opacity: 1; }

    .btn-login {
        width: 100%;
        padding: 0.85rem;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .btn-login:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(102,126,234,0.4);
    }

    .btn-login:disabled { opacity: 0.5; cursor: not-allowed; }

    .btn-offline {
        background: linear-gradient(135deg, #f093fb, #f5576c);
        margin-top: 1rem;
    }

    .btn-link {
        background: none;
        border: none;
        color: rgba(255,255,255,0.5);
        font-size: 0.85rem;
        cursor: pointer;
        margin-top: 0.5rem;
        width: 100%;
        text-align: center;
        text-decoration: underline;
    }

    .btn-link:hover { color: rgba(255,255,255,0.8); }

    .spinner {
        width: 18px; height: 18px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        display: inline-block;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    .alert {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        padding: 0.85rem 1rem;
        border-radius: 12px;
        font-size: 0.88rem;
        margin-bottom: 1rem;
    }

    .alert-warning {
        background: rgba(255, 193, 7, 0.15);
        border: 1px solid rgba(255, 193, 7, 0.3);
        color: #ffc107;
    }

    .alert-error {
        background: rgba(255, 107, 107, 0.15);
        border: 1px solid rgba(255, 107, 107, 0.3);
        color: #ff6b6b;
    }

    .alert strong { display: block; margin-bottom: 0.2rem; }
    .alert p { margin: 0; opacity: 0.85; }
    .alert-icon { font-size: 1.2rem; flex-shrink: 0; }

    .offline-session {
        text-align: center;
        color: rgba(255,255,255,0.8);
    }

    .offline-icon { font-size: 3rem; margin-bottom: 1rem; }

    .offline-tenant-info {
        background: rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        margin: 1rem 0;
    }

    .offline-tenant-info strong {
        display: block;
        color: #fff;
        font-size: 1rem;
    }

    .offline-tenant-info span {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.5);
    }

    .offline-alert {
        display: flex;
    }

    .login-footer {
        text-align: center;
        margin-top: 2rem;
        font-size: 0.78rem;
        color: rgba(255,255,255,0.25);
    }
</style>

@code {
    [Parameter] public EventCallback OnLoginSuccess { get; set; }

    private string _email        = string.Empty;
    private string _password     = string.Empty;
    private string _errorMessage = string.Empty;
    private bool   _loading      = false;
    private bool   _showPassword = false;
    private bool   _showOfflineOption  = false;
    private string _savedTenantName    = string.Empty;
    private string _savedEmail         = string.Empty;

    private bool HasError => !string.IsNullOrEmpty(_errorMessage);

    protected override async Task OnInitializedAsync()
    {
        // Verificar si hay sesión guardada pero no hay internet
        if (!Connectivity.IsOnline)
        {
            var restored = await TenantService.TryRestoreSessionAsync();
            if (restored)
            {
                _showOfflineOption = true;
                _savedTenantName   = TenantService.TenantName;
                _savedEmail        = TenantService.CurrentEmail;
            }
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "Ingresá tu email y contraseña.";
            return;
        }

        _loading = true;
        _errorMessage = string.Empty;

        try
        {
            var (tenantId, tenantName) = await AuthService.LoginAsync(_email.Trim(), _password);
            await TenantService.SetSessionAsync(tenantId, _email.Trim(), tenantName);
            await OnLoginSuccess.InvokeAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ContinueOffline()
    {
        // La sesión ya está restaurada en OnInitializedAsync
        await OnLoginSuccess.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleLogin();
    }
}
